{
  "name": "permaura-core",
  "private": true,
  "version": "0.1.0",
  "description": "Permaura engine: Rust capability broker, policy engine, and MCP gateway, plus the TypeScript SDK and MCP stdio bridge.",
  "homepage": "https://permaura.com",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "core:build": "cargo build",
    "core:test": "cargo test",
    "gateway": "cargo run -p permaura-gateway -- start",
    "cli": "cargo run -p permaura-gateway --",
    "mcp:build": "pnpm --filter @permaura/mcp-stdio build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
