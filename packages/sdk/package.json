{
  "name": "@permaura/sdk",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript SDK for Permaura: a typed REST client plus the defineConnector authoring API and redact helper for building secretless agent capabilities.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelitemedia/permaura.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsup && node --test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@permaura/types": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
